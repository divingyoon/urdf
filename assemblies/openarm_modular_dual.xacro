<?xml version="1.0"?>
<robot name="openarm_dual_modular" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Modular dual configuration:
      - Left: OpenArm with simple left gripper
      - Right: OpenArm with Tesollo 5-DoF right hand

    Goals
      - Single-root kinematic chains for each arm
      - Palm COM helper frame on each end-effector (palm_link_com)
      - Clean fixed mounting between link7 and end-effector base
      - Meters, Z-up, axis consistency

    Parameters
      - mount transforms allow quick tuning after import in Isaac Sim
  -->

  <!-- External dependencies -->
  <xacro:include filename="$(find openarm_description)/urdf/robot/openarm_robot.xacro"/>

  <!-- Local end-effector wrappers -->
  <xacro:include filename="$(find openarm_description)/urdf/ee/openarm_hand.xacro"/>
  <xacro:include filename="$(find openarm_description)/urdf/ee/openarm_hand_macro.xacro"/>
  <xacro:include filename="../eef/tesollo_right_wrapper.xacro"/>

  <!-- Common properties -->
  <xacro:property name="deg" value="0.017453292519943295"/>

  <!-- Compatibility args for upstream xacro that incorrectly uses $(eval hand/ee_type). -->
  <xacro:arg name="hand" default="false"/>
  <xacro:arg name="ee_type" default="none"/>

  <!-- Mount transforms (tune as needed) -->
  <xacro:arg name="right_mount_xyz" default="0 0.0000003 0.0595695"/>
  <xacro:arg name="right_mount_rpy" default="0 0 -1.5707964"/>
  <xacro:arg name="left_mount_xyz"  default="0 0 0.1001"/>
  <xacro:arg name="left_mount_rpy"  default="0 0 0"/>
  <xacro:arg name="left_tcp_xyz" default="0 0 0.08"/>
  <xacro:arg name="left_tcp_rpy" default="0 0 0"/>

  <!-- Optional: path to Tesollo upstream xacro -->
  <xacro:arg name="tesollo_xacro" default="$(find dg_description)/urdf/dg5f_right.xacro"/>

  <!-- Instantiate the stock OpenArm dual-arm body, but omit built-in hands. -->
  <xacro:openarm_robot
    arm_type="v10"
    body_type="v10"
    joint_limits="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/joint_limits.yaml')}"
    control_gains="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/control_gains.yaml')}"
    inertials="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/inertials.yaml')}"
    kinematics="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/kinematics.yaml')}"
    kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/kinematics_link.yaml')}"
    kinematics_offset="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/kinematics_offset.yaml')}"
    body_inertials="${xacro.load_yaml('$(find openarm_description)/config/body/v10/inertials.yaml')}"
    body_kinematics="${xacro.load_yaml('$(find openarm_description)/config/body/v10/kinematics.yaml')}"
    body_kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/body/v10/kinematics.yaml')}"
    ee_kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/hand/openarm_hand/kinematics_link.yaml')}"
    hand="false"
    ee_type="none"
    ros2_control="false"
    can_interface="can0"
    left_can_interface="can1"
    right_can_interface="can0"
    left_arm_prefix="left_"
    right_arm_prefix="right_"
    use_fake_hardware="false"
    fake_sensor_commands="false"
    no_prefix="false"
    arm_prefix=""
    body_prefix=""
    arm_connected_to="base"
    body_connected_to="world"
    bimanual="true"
    right_arm_base_xyz="0.0 -0.031 0.698"
    left_arm_base_xyz="0.0 0.031 0.698"
    right_arm_base_rpy="1.5708 0 0"
    left_arm_base_rpy="-1.5708 0 0"
    can_fd="true"
  />

  <!-- LEFT: Stock OpenArm hand on openarm_left_link7 -->
  <xacro:openarm_hand
    connected_to="openarm_left_link7"
    arm_type="v10"
    arm_prefix="left_"
    ee_type="openarm_hand"
    ee_kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/hand/openarm_hand/kinematics_link.yaml')}"
    ee_inertials="${xacro.load_yaml('$(find openarm_description)/config/hand/openarm_hand/inertials.yaml')}"
    xyz_ee="$(arg left_mount_xyz)"
    rpy_ee="$(arg left_mount_rpy)"
    tcp_xyz="$(arg left_tcp_xyz)"
    tcp_rpy="$(arg left_tcp_rpy)"
    description_pkg="openarm_description"
  />

  <!-- RIGHT: Tesollo right hand on openarm_right_link7 -->
  <xacro:tesollo_right_with_frames prefix="" tesollo_xacro="$(arg tesollo_xacro)" palm_com_xyz="0.028 0 0.04"/>

  <joint name="mount_right_link7_to_tesollo" type="fixed">
    <parent link="openarm_right_link7"/>
    <child  link="right_base_link"/>
    <origin xyz="$(arg right_mount_xyz)" rpy="$(arg right_mount_rpy)"/>
  </joint>

</robot>
